# 复制一份为 .env 再改：cp .env.example .env
# .env 已被 .gitignore 忽略，密钥不会被提交

# —— Minecraft 连接 ——
MC_HOST=localhost
MC_PORT=25565
# NPC 在游戏里的 ID（英文/数字/下划线）
MC_USERNAME=AgentBot
# offline：离线服 / 局域网离线账号；microsoft：正版服
MC_AUTH=offline
# 留空自动探测服务器版本，探测失败时手动填，例如 1.21.6
MC_VERSION=

# —— NPC ——
# 人设名字：玩家喊这个名字或 MC_USERNAME 都会触发回复
NPC_NAME=阿方
# mention：被点名或私聊才回；all：公屏每句都回
CHAT_TRIGGER=mention
CHAT_MEMORY_SIZE=12

# —— 大模型（任意 OpenAI 兼容接口）——
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
