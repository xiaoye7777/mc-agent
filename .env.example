# 复制一份为 .env 再改：cp .env.example .env
# .env 已被 .gitignore 忽略，密钥不会被提交

# —— Minecraft 连接 ——
MC_HOST=localhost
MC_PORT=25565
# NPC 在游戏里的 ID（英文/数字/下划线）
MC_USERNAME=AgentBot
# offline：离线服 / 局域网离线账号；microsoft：正版服
MC_AUTH=offline
# 留空自动探测服务器版本，探测失败时手动填，例如 1.21.6
MC_VERSION=

# —— NPC ——
# 人设名字：玩家喊这个名字或 MC_USERNAME 都会触发回复
NPC_NAME=阿方
# mention：被点名或私聊才回；all：公屏每句都回
CHAT_TRIGGER=mention
CHAT_MEMORY_SIZE=12
# 允许挖天然方块（原木、泥土、石头、矿石；只在玩家要求时挖，木板圆石玻璃等建材不碰）。false = 完全不挖
NPC_ALLOW_DIG=true
# 允许打敌对怪物（僵尸、骷髅……；永远不打玩家和动物）。false = 完全不打
NPC_ALLOW_COMBAT=true
# 自主发育（从零发育到钻石……）：off / on（玩家要求时开始）/ auto（进服就开始）。会大量挖方块、放方块，只在自己的测试服用！
# 一般不用改这里，直接 npm run survive（自动连本地测试服并开始发育）
NPC_AUTONOMY=off

# —— 大模型（任意 OpenAI 兼容接口）——
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
