{
  "name": "mc-agent",
  "version": "0.3.0",
  "private": true,
  "description": "基于 mineflayer 的 Minecraft NPC Agent：能聊天、能听指挥干活",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test-server": "bash scripts/paper-server.sh",
    "test-server:lite": "node scripts/test-server.cjs",
    "say": "node scripts/say.cjs",
    "survive": "node scripts/survive.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "agent",
    "llm",
    "npc"
  ],
  "dependencies": {
    "dotenv": "^18.0.10",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5"
  },
  "devDependencies": {
    "flying-squid": "^1.12.0"
  }
}
